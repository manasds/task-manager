# Neon Postgres. Dashboard → your project → Connect. Prefer the pooled URI.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth + Google. Callback: {BETTER_AUTH_URL}/api/auth/callback/google
# The deployed origin. `pnpm dev` ignores it and uses http://localhost:<port>, so register
# http://localhost:3000/api/auth/callback/google in Google Cloud Console too.
BETTER_AUTH_URL="https://your-domain.example"
BETTER_AUTH_SECRET="openssl-rand-base64-32-or-longer"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Optional: a throwaway database for `pnpm test`'s Postgres sync test. Never point this at production.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/test?sslmode=require"
