# Neon Postgres (required for multi-user sync).
# Dashboard → your project → Connect. Prefer the pooled URI for the API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth + Google. Callback: {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="openssl-rand-base64-32-or-longer"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
